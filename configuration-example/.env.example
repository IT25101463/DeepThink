# ==============================================================================
# SLIIT Codefest 2026 - AI Competition
# Team DeepThink - Environment Variables Template
#
# IMPORTANT: Copy this file to .env (do NOT commit .env into git)
# ==============================================================================

# Voyage AI API Key (For dense vector embeddings - voyage-4 / voyage-4-lite)
# Get from https://dashboard.voyageai.com/
VOYAGE_API_KEY=your_voyage_api_key_here

# OpenRouter API Key (For LLM Generation)
# Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model Selection
# Recommended free/cheap models: meta-llama/llama-3.3-70b-instruct:free, deepseek/deepseek-chat
LLM_MODEL_NAME=meta-llama/llama-3.3-70b-instruct:free
EMBEDDING_MODEL_NAME=voyage-4

# Path Configurations
ASSET_CORPUS_DIR=./data/ashen_era_archive
EXTRACTED_MEDIA_DIR=./data/extracted_media
CHUNKS_JSON_PATH=./data/chunks.json
CHROMA_PERSIST_DIR=./chroma_db

# Retrieval Parameters
DEFAULT_TOP_K=5
MODALITY_BOOST_FACTOR=1.5

# Server & UI
STREAMLIT_SERVER_PORT=8501
DEBUG_MODE=False
