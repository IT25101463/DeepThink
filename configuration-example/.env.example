# ==============================================================================
# SLIIT Codefest 2026 - AI Competition
# Team DeepThink - Environment Variables Template (100% Free Stack)
#
# IMPORTANT: Copy this file to .env (do NOT commit .env into git)
# ==============================================================================

# Groq API Key (100% Free, NO credit card needed, ultra-fast 300 tokens/sec)
# Get your free key in 20 seconds at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# LLM Model Selection (Defaults to Groq Flagship GPT-OSS 120B)
LLM_MODEL_NAME=openai/gpt-oss-120b

# Embedding Model (100% Free Local BGE embeddings - Zero Card / Zero Key needed)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Path Configurations
ASSET_CORPUS_DIR=data/Ashen_Era_Archive
EXTRACTED_MEDIA_DIR=data/extracted_media
CHUNKS_JSON_PATH=data/chunks.json
CHROMA_PERSIST_DIR=chroma_db

# Retrieval Parameters
DEFAULT_TOP_K=5
MODALITY_BOOST_FACTOR=1.5

# Server & UI
STREAMLIT_SERVER_PORT=8501
DEBUG_MODE=False
